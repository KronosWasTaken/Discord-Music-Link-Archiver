# Copy this file to .env (which is gitignored) and fill in real values
# before running `docker compose up`.

# The public URL Funnel serves this app at. SvelteKit needs this to validate
# form submissions aren't cross-site — update it if you rename the machine
# or tailnet, then `docker compose up -d` to apply.
PUBLIC_ORIGIN=https://your-machine-name.your-tailnet.ts.net

# Login credentials for the whole app — required since it's exposed to the
# public internet via Tailscale Funnel.
BASIC_AUTH_USER=changeme
BASIC_AUTH_PASS=change-this-too

# Internal API key for the Typesense sidecar — only reachable from the app
# container over the compose network, never published to the host.
TYPESENSE_API_KEY=change-this-too
